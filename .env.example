# copy to .env (gitignored). Used by Taskfile.yml. Keep comments on their own lines.
# key that can ssh into the ops host and the contest/practice hosts
SSH_KEY=~/.ssh/aws/own/enechain.pem
# shared ops host (control panel)
OPS_HOST=13.192.87.207
# space-separated contest/practice hosts (svc1 svc2 svc3)
HOSTS=
# ^ space separated, in order: svc1 svc2 svc3. After this, tasks take HOST=1|2|3 (or db / svcN); omitted = svc1. No more IPs to type.
# login user for ssh (practice AMI: ubuntu; contest: isucon)
HOST_LOGIN=ubuntu
# app user on the hosts (bootstrap target, ops key goes here)
HOST_USER=isucon
# run label / data namespace on the ops host
CONTEST=practice
# webapp language dirs to keep in git
LANGS=go
# contest repo for ROLE=init/join (empty for local)
GIT_REMOTE=
# access-log regex that starts a measurement run
TRIGGER=^POST (/api)?/initialize
# local clone of the contest repo (for task retro: commits between runs). Empty = skip
REPO_DIR=
# panel URL for links in issues (default: https://<OPS_HOST with dots as dashes>.sslip.io)
PANEL_URL=
# hosts deployed first by task deploy, space-separated, in that order (each an IP, 1|2|3, svcN or db), then the rest.
# Put every host whose DB others need at start first: the app DB host, then the host holding PowerDNS's DB
# (2026-10-27: isudns on svc2, deploy went svc3 -> svc1 and svc1's pdns could not start). Example: DEPLOY_FIRST=3 2
# Empty = 3rd of HOSTS only
DEPLOY_FIRST=
# practice run (1 = yes; HOST_LOGIN=ubuntu also counts): task hosts:setup then prints a BENCH_CMD line to paste below
PRACTICE=
# bench command put in the hub's bench todo (task hub:ship). Empty = "run the bench on the portal" (contest day).
# Practice: paste the line hosts:setup prints (ISUCON13: ssh to svc2, ./bench run --nameserver/--webapp <svc1 private IP>; RUNBOOK 付録)
BENCH_CMD=
# GitHub Project that task actions:issues adds each created issue to: "owner/number" (e.g. ytakaya/3) or just the
# number (owner = the REPO's owner). Needs the project scope once: gh auth refresh -s project. Empty = issues only
GH_PROJECT=

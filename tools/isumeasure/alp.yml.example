# Example (isucon13 practice). Each contest repo gets its own from `task groups`; this copy is only a sample of the format.
# Endpoint groups for alp and isumeasure. Generated by `isumeasure groups -code webapp/go`; edit freely.
# Order matters: the first matching regex wins, so literal paths (/api/user/me) sit above the parameterized
# siblings (/api/user/[^/]+) that would swallow them. Re-generate when routes are added, or append by hand.
#   alp:        alp ltsv --config alp.yml -r --sort sum --file access.log
#   isumeasure: report / export / the ops panel read this file from the repo root (alp ignores `names`).
matching_groups:
  - "^/api/livestream/reservation$"   # POST
  - "^/api/livestream/search$"   # GET
  - "^/api/user/me$"   # GET
  - "^/api/icon$"   # POST
  - "^/api/initialize$"   # POST
  - "^/api/livestream$"   # GET
  - "^/api/login$"   # POST
  - "^/api/payment$"   # GET
  - "^/api/register$"   # POST
  - "^/api/tag$"   # GET
  - "^/api/livestream/[^/]+/enter$"   # POST
  - "^/api/livestream/[^/]+/exit$"   # DELETE
  - "^/api/livestream/[^/]+/livecomment$"   # GET, POST
  - "^/api/livestream/[^/]+/moderate$"   # POST
  - "^/api/livestream/[^/]+/ngwords$"   # GET
  - "^/api/livestream/[^/]+/reaction$"   # GET, POST
  - "^/api/livestream/[^/]+/report$"   # GET
  - "^/api/livestream/[^/]+/statistics$"   # GET
  - "^/api/user/[^/]+/icon$"   # GET
  - "^/api/user/[^/]+/livestream$"   # GET
  - "^/api/user/[^/]+/statistics$"   # GET
  - "^/api/user/[^/]+/theme$"   # GET
  - "^/api/livestream/[^/]+$"   # GET
  - "^/api/user/[^/]+$"   # GET
  - "^/api/livestream/[^/]+/livecomment/[^/]+/report$"   # POST
names:   # isumeasure only: how the group is shown (default: the regex with [^/]+ as :id)
  "^/api/livestream/[^/]+/enter$": "/api/livestream/:livestream_id/enter"
  "^/api/livestream/[^/]+/exit$": "/api/livestream/:livestream_id/exit"
  "^/api/livestream/[^/]+/livecomment$": "/api/livestream/:livestream_id/livecomment"
  "^/api/livestream/[^/]+/moderate$": "/api/livestream/:livestream_id/moderate"
  "^/api/livestream/[^/]+/ngwords$": "/api/livestream/:livestream_id/ngwords"
  "^/api/livestream/[^/]+/reaction$": "/api/livestream/:livestream_id/reaction"
  "^/api/livestream/[^/]+/report$": "/api/livestream/:livestream_id/report"
  "^/api/livestream/[^/]+/statistics$": "/api/livestream/:livestream_id/statistics"
  "^/api/user/[^/]+/icon$": "/api/user/:username/icon"
  "^/api/user/[^/]+/livestream$": "/api/user/:username/livestream"
  "^/api/user/[^/]+/statistics$": "/api/user/:username/statistics"
  "^/api/user/[^/]+/theme$": "/api/user/:username/theme"
  "^/api/livestream/[^/]+$": "/api/livestream/:livestream_id"
  "^/api/user/[^/]+$": "/api/user/:username"
  "^/api/livestream/[^/]+/livecomment/[^/]+/report$": "/api/livestream/:livestream_id/livecomment/:livecomment_id/report"
# isumeasure only: the POST that earns score (from the manual's score formula). The panel's Score timeline then
# shows score ÷ its count per run, and report.md prints the count. Use the name as shown in the report.
score_post: "POST /api/livestream/:livestream_id/livecomment"

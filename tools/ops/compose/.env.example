# copy to .env
# domain that resolves to this host's public IP. sslip.io encodes the IP in the name, so no DNS setup is needed:
PANEL_DOMAIN=3-112-200-249.sslip.io
BASIC_USER=isucon
# generate: docker run --rm caddy:2 caddy hash-password --plaintext 'your-long-random-password'
BASIC_HASH=$2a$14$replace-me
